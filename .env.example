DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
AI_GATEWAY_API_KEY=

# Free-tier mode (see src/lib/ai/model.ts): bypasses Vercel AI Gateway (which
# requires a positive balance for every call, even BYOK) and calls provider
# APIs directly using their free, no-credit-card tiers, so the pipeline can
# be smoke-tested without paying for Gateway credits. Existing Gateway
# config above is left untouched - set AI_PROVIDER_MODE=free to opt in,
# omit/leave "gateway" for current paid behavior.
AI_PROVIDER_MODE=gateway
GOOGLE_GENERATIVE_AI_API_KEY=
ELEVENLABS_API_KEY=

# Faz G3 (see ROADMAP.md): provision via `vercel integration add clerk`,
# then `vercel env pull` to populate these.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Hikaye Stüdyosu video (see ROADMAP.md): create at console.higgsfield.ai.
# The video-generation tool/button in /studio silently returns a "Higgsfield
# API key henüz eklenmedi" failure until both are set - no other code change
# is needed once they are.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
