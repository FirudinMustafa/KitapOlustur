// Builds src/lib/cefr-j-wordlist.ts from the CEFR-J Wordlist CSV
// (https://github.com/openlanguageprofiles/olp-en-cefrj,
// cefrj-vocabulary-profile-1.5.csv). Re-run when the list is updated:
//
//   npx tsx scripts/build-cefrj-wordlist.mts <cefrj-vocabulary-profile.csv>
import fs from "node:fs";

const BANDS = ["A1", "A2", "B1", "B2"] as const;

const csv = fs.readFileSync(process.argv[2], "utf8");
const words = new Map<string, (typeof BANDS)[number]>();
for (const row of csv.split(/\r?\n/).slice(1)) {
  // headword,pos,CEFR,... - headwords may hold variants ("a.m./A.M./am/AM")
  const [headword, , level] = row.split(",");
  const band = BANDS.find((b) => b === level?.trim());
  if (!headword || !band) continue;
  for (const variant of headword.split("/")) {
    const w = variant.trim().toLowerCase();
    if (!/^[a-z][a-z'-]*$/.test(w)) continue; // single words only
    const had = words.get(w);
    if (!had || BANDS.indexOf(band) < BANDS.indexOf(had)) words.set(w, band); // easiest sense wins
  }
}

const byBand = Object.fromEntries(BANDS.map((b) => [b, [...words].filter(([, band]) => band === b).map(([w]) => w).sort()]));
const out = [
  "// Generated by scripts/build-cefrj-wordlist.mts from the CEFR-J Wordlist",
  "// Version 1.5, compiled by Yukio Tono, Tokyo University of Foreign Studies",
  "// (Tono Laboratory, TUFS; distributed by Open Language Profiles - free for",
  "// research and commercial use, with citation). Single-word headwords only,",
  "// each at the level of its easiest sense. Do not edit by hand.",
  "",
  "export const CEFRJ_WORDS = {",
  ...BANDS.map((b) => `  ${b}: ${JSON.stringify(byBand[b].join(" "))},`),
  "} as const;",
  "",
].join("\n");
fs.writeFileSync("src/lib/cefr-j-wordlist.ts", out);
console.log(BANDS.map((b) => `${b} ${byBand[b].length}`).join(", "));
